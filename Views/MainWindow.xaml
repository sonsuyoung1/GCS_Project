<Window x:Class="GCS_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="GCS Dashboard" Height="850" Width="1600" Background="#1A1A1A"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">
    <Window.Resources>
        <Style x:Key="BaseText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="Foreground" Value="#95A5A6"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="GcsButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#4A5568"/>
                                <Setter Property="Foreground" Value="#CBD5E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="GcsToggleButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34495E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#4A5568"/>
                                <Setter Property="Foreground" Value="#CBD5E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="300"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Drone Video" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="14" Margin="5,2"/>

                    <Grid Grid.Row="1" x:Name="VideoHostGrid">
                        <vlc:VideoView x:Name="VideoView1"
                                       Background="Black"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Detected Targets" Foreground="#3B82F6" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding DetectedTargets}" 
                                      SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" 
                                      AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="Transparent" Foreground="White" 
                                      RowBackground="Transparent" GridLinesVisibility="None" 
                                      SelectionMode="Single" BorderThickness="0" SelectionChanged="DataGrid_SelectionChanged">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1A2233"/>
                                <Setter Property="Foreground" Value="#8AB4F8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="#34495E"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Height" Value="28"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                            <DataGridTextColumn Header="TYPE" Binding="{Binding TargetType}" Width="*"/>
                            <DataGridTextColumn Header="LAT" Binding="{Binding Lat, StringFormat={}{0:F5}}" Width="*"/>
                            <DataGridTextColumn Header="LNG" Binding="{Binding Lng, StringFormat={}{0:F5}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,15,0,0">
                        <Button Content="STRIKE" 
                                        Command="{Binding StrikeCommand}"
                                        CommandParameter="{Binding SelectedTarget}"
                                        Background="#EF4444" Foreground="White" 
                                        FontWeight="Bold" FontSize="16" Height="50"
                                        Margin="0,0,5,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="STRIKE STOP" 
                                        Command="{Binding StopStrikeCommand}"
                                        Background="#F59E0B" Foreground="White" 
                                        FontWeight="Bold" FontSize="16" Height="50"
                                        Margin="5,0,0,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0F172A" Padding="15,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Style="{StaticResource StatusGroup}">
                            <TextBlock Text="Mode " Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding FlightMode}" Foreground="#22C55E"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource StatusGroup}">
                            <TextBlock Text="Arm " Foreground="#94A3B8"/>
                            <TextBlock FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="DISARMED" />
                                        <Setter Property="Foreground" Value="#EF4444" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Drone.IsArmed}" Value="True">
                                                <Setter Property="Text" Value="ARMED" />
                                                <Setter Property="Foreground" Value="#22C55E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Style="{StaticResource StatusGroup}">
                            <TextBlock Text="Battery " Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Drone.BatteryPercent, StringFormat={}{0}%}" Foreground="#22C55E"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource StatusGroup}">
                            <TextBlock Text="Link " Foreground="#94A3B8"/>
                            <TextBlock FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="DISCONNECTED" />
                                        <Setter Property="Foreground" Value="#EF4444" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Drone.IsConnected}" Value="True">
                                                <Setter Property="Text" Value="CONNECTED" />
                                                <Setter Property="Foreground" Value="#22C55E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Time " Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding CurrentDateTime}" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="MapContainer">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="103*"/>
                    <ColumnDefinition Width="352*"/>
                </Grid.ColumnDefinitions>
                <wv2:WebView2 x:Name="mapWebView" Grid.ColumnSpan="2" />
            </Grid>

            <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#34495E" BorderThickness="0,2,0,0">
                <UniformGrid Columns="7" Margin="10,0">

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Pitch" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Drone.Pitch, StringFormat={}{0:F1}°}" Style="{StaticResource ValueText}"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Roll" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Drone.Roll, StringFormat={}{0:F1}°}" Style="{StaticResource ValueText}"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Yaw" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Drone.Yaw, StringFormat={}{0:F1}°}" Style="{StaticResource ValueText}"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cur Altitude" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Drone.Altitude, StringFormat={}{0:F1} m}" Style="{StaticResource ValueText}" Foreground="#2ECC71"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cur Speed" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Drone.Speed, StringFormat={}{0:F1} m/s}" Style="{StaticResource ValueText}" Foreground="#3498DB"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Altitude" Style="{StaticResource LabelText}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <Button Content="-" Command="{Binding DecreaseAltitudeCommand}" 
                        Width="25" Height="25" Background="#34495E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>

                            <TextBox Text="{Binding Drone.TargetAltitude, UpdateSourceTrigger=PropertyChanged}" 
                         Width="50" Height="25" Background="Transparent" Foreground="#2ECC71" 
                         FontWeight="Bold" FontSize="16" TextAlignment="Center" 
                         BorderThickness="0,0,0,1" BorderBrush="#4A5568" Margin="5,0"/>

                            <Button Content="+" Command="{Binding IncreaseAltitudeCommand}" 
                        Width="25" Height="25" Background="#34495E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Speed" Style="{StaticResource LabelText}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <Button Content="-" Command="{Binding DecreaseSpeedCommand}" 
                        Width="25" Height="25" Background="#34495E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>

                            <TextBox Text="{Binding Drone.TargetSpeed, UpdateSourceTrigger=PropertyChanged}" 
                         Width="50" Height="25" Background="Transparent" Foreground="#3498DB" 
                         FontWeight="Bold" FontSize="16" TextAlignment="Center" 
                         BorderThickness="0,0,0,1" BorderBrush="#4A5568" Margin="5,0"/>

                            <Button Content="+" Command="{Binding IncreaseSpeedCommand}" 
                        Width="25" Height="25" Background="#34495E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>

                </UniformGrid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="#1E293B" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Command Button" Foreground="White" FontSize="18" Margin="0,0,0,15"/>

                <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">
                    <Button Content="Mission Start" Command="{Binding StartMissionCommand}" Background="#E74C3C" Style="{StaticResource GcsButton}"/>
                    <Button Content="Stop" Command="{Binding StopMissionCommand}" Background="#E74C3C" Style="{StaticResource GcsButton}"/>
                    <Button Content="Undo" Command="{Binding UndoWaypointCommand}" Background="#4A5568" Style="{StaticResource GcsButton}"/>
                    <Button Content="Clear All" Command="{Binding ClearWaypointsCommand}" Background="#4A5568" Style="{StaticResource GcsButton}"/>
                    <Button Content="Takeoff" Command="{Binding TakeoffCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                    <Button Content="Landing" Command="{Binding LandingCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                    <Button Content="Return" Command="{Binding RtlCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                    <Button Content="Arm" Command="{Binding ArmCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                    <Button Content="Disarm" Command="{Binding DisarmCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>

                    <ToggleButton x:Name="ManualModeToggle" 
                                          Content="Manual Mode" 
                                          Style="{StaticResource GcsToggleButton}"
                                          Checked="ManualModeToggle_Checked" 
                                          Unchecked="ManualModeToggle_Unchecked"/>

                    <Button Content="Show History"  Command="{Binding ShowHistoryCommand}" Background="#4A5568" Style="{StaticResource GcsButton}"/>

                    
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5,0">
                        <TextBlock Text="Date:" Foreground="White" FontSize="11" Margin="2,0,0,2"/>
                        <DatePicker SelectedDate="{Binding SelectedHistoryDate}" FontSize="12" Height="24"/>
                    </StackPanel>
                </UniformGrid>

                <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Flight Instruments" Foreground="#3B82F6" FontWeight="Bold" FontSize="12" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsHitTestVisible="False">

                            <Border Width="100" Height="100" CornerRadius="50" Margin="10,5,10,10" BorderBrush="White" BorderThickness="1.5" Background="#222">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.5" Direction="225"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.Clip>
                                        <EllipseGeometry Center="50,50" RadiusX="49" RadiusY="49"/>
                                    </Grid.Clip>
                                    <Grid x:Name="HorizonContainer" Height="1000" VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform Y="{Binding PitchOffset}"/>
                                                <RotateTransform Angle="{Binding Drone.Roll}" CenterX="50" CenterY="500"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.Row="0" Fill="#4472C4"/>
                                        <Rectangle Grid.Row="1" Fill="#638C3C"/>
                                        <Canvas>
                                            <Rectangle Canvas.Top="499" Width="100" Height="2" Fill="White" Opacity="0.8"/>
                                            <Line X1="35" Y1="464.5" X2="65" Y2="464.5" Stroke="White" StrokeThickness="1.5"/>
                                            <TextBlock Text="10" Foreground="White" FontSize="7" Canvas.Top="460" Canvas.Left="68"/>
                                            <TextBlock Text="10" Foreground="White" FontSize="7" Canvas.Top="460" Canvas.Left="22"/>
                                            <Line X1="40" Y1="429" X2="60" Y2="429" Stroke="White" StrokeThickness="1.2" Opacity="0.8"/>
                                            <TextBlock Text="20" Foreground="White" FontSize="7" Canvas.Top="424" Canvas.Left="63"/>
                                            <TextBlock Text="20" Foreground="White" FontSize="7" Canvas.Top="424" Canvas.Left="28"/>
                                            <Line X1="45" Y1="393.5" X2="55" Y2="393.5" Stroke="White" StrokeThickness="1" Opacity="0.6"/>
                                            <TextBlock Text="30" Foreground="White" FontSize="6" Canvas.Top="389" Canvas.Left="58"/>
                                            <TextBlock Text="30" Foreground="White" FontSize="6" Canvas.Top="389" Canvas.Left="35"/>
                                            <Line X1="35" Y1="535.5" X2="65" Y2="535.5" Stroke="White" StrokeThickness="1.5"/>
                                            <TextBlock Text="-10" Foreground="White" FontSize="7" Canvas.Top="531" Canvas.Left="68"/>
                                            <TextBlock Text="-10" Foreground="White" FontSize="7" Canvas.Top="531" Canvas.Left="15"/>
                                            <Line X1="40" Y1="571" X2="60" Y2="571" Stroke="White" StrokeThickness="1.2" Opacity="0.8"/>
                                            <TextBlock Text="-20" Foreground="White" FontSize="7" Canvas.Top="566" Canvas.Left="63"/>
                                            <TextBlock Text="-20" Foreground="White" FontSize="7" Canvas.Top="566" Canvas.Left="10"/>
                                        </Canvas>
                                    </Grid>
                                    <Canvas IsHitTestVisible="False">
                                        <Rectangle Canvas.Left="49.2" Canvas.Top="2" Width="1.5" Height="8" Fill="#FF3B3B"/>
                                        <Line X1="50" Y1="2" X2="50" Y2="7" Stroke="White" StrokeThickness="1">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="-30" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Line X1="50" Y1="2" X2="50" Y2="7" Stroke="White" StrokeThickness="1">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="30" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Line X1="50" Y1="2" X2="50" Y2="10" Stroke="White" StrokeThickness="1.5">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="-60" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Line X1="50" Y1="2" X2="50" Y2="10" Stroke="White" StrokeThickness="1.5">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="60" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                    </Canvas>
                                    <Canvas IsHitTestVisible="False">
                                        <Line X1="25" Y1="50" X2="42" Y2="50" Stroke="Yellow" StrokeThickness="2.5"/>
                                        <Line X1="58" Y1="50" X2="75" Y2="50" Stroke="Yellow" StrokeThickness="2.5"/>
                                        <Ellipse Canvas.Left="46.5" Canvas.Top="46.5" Width="7" Height="7" Fill="Yellow"/>
                                    </Canvas>
                                </Grid>
                            </Border>

                            <Border Width="100" Height="100" CornerRadius="50" Margin="10,5,10,10" BorderBrush="White" BorderThickness="1.5" Background="#111">
                                <Grid>
                                    <Grid>
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="{Binding HeadingOffset}" CenterX="50" CenterY="50"/>
                                        </Grid.RenderTransform>
                                        <Canvas Width="100" Height="100">
                                            <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                                <Line.RenderTransform>
                                                    <RotateTransform Angle="30" CenterX="50" CenterY="50"/>
                                                </Line.RenderTransform>
                                            </Line>
                                            <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                                <Line.RenderTransform>
                                                    <RotateTransform Angle="60" CenterX="50" CenterY="50"/>
                                                </Line.RenderTransform>
                                            </Line>
                                            <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                                <Line.RenderTransform>
                                                    <RotateTransform Angle="120" CenterX="50" CenterY="50"/>
                                                </Line.RenderTransform>
                                            </Line>
                                            <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                                <Line.RenderTransform>
                                                    <RotateTransform Angle="150" CenterX="50" CenterY="50"/>
                                                </Line.RenderTransform>
                                            </Line>
                                            <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                                <Line.RenderTransform>
                                                    <RotateTransform Angle="210" CenterX="50" CenterY="50"/>
                                                </Line.RenderTransform>
                                            </Line>
                                            <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                                <Line.RenderTransform>
                                                    <RotateTransform Angle="240" CenterX="50" CenterY="50"/>
                                                </Line.RenderTransform>
                                            </Line>
                                            <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                                <Line.RenderTransform>
                                                    <RotateTransform Angle="300" CenterX="50" CenterY="50"/>
                                                </Line.RenderTransform>
                                            </Line>
                                            <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                                <Line.RenderTransform>
                                                    <RotateTransform Angle="330" CenterX="50" CenterY="50"/>
                                                </Line.RenderTransform>
                                            </Line>
                                        </Canvas>
                                        <TextBlock Text="N" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <TextBlock Text="S" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        <TextBlock Text="E" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBlock Text="W" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Grid>
                                    <Viewbox Width="30" Height="30">
                                        <Canvas Width="100" Height="100">
                                            <Path Fill="#EE3424" Data="M 50,0 L 100,100 L 50,75 Z"/>
                                            <Path Fill="#C72B27" Data="M 50,0 L 0,100 L 50,75 Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Path Data="M 0,0 L 8,0 L 4,8 Z" Fill="Yellow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,5,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="System Log and AI Command" Foreground="#3B82F6" 
                   FontWeight="Bold" FontSize="11" Margin="0,0,0,5"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,5">
                            <TextBox Text="{Binding ChatLog, Mode=OneWay}" 
                                            Foreground="White"
                                             IsReadOnly="True" 
                                             TextWrapping="Wrap" 
                                             VerticalScrollBarVisibility="Auto" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             FontSize="14" />
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="#1E293B" CornerRadius="5" Padding="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text=">" Foreground="#38BDF8" FontWeight="Bold" 
                                                    VerticalAlignment="Center" Margin="5,0,5,0"/>

                                <TextBox x:Name="AiCommandTextBox"
                                         Grid.Column="1"
                                         Text="{Binding UserInputCommand, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         Foreground="#F1F5F9"
                                         BorderThickness="0"
                                         CaretBrush="#38BDF8"
                                         VerticalContentAlignment="Center"
                                         FontSize="12"
                                         AcceptsReturn="False"
                                         KeyDown="AiCommandTextBox_KeyDown"/>

                                <Button Grid.Column="2" Content="SEND" Command="{Binding SendAICommand}"
                                                Background="Transparent" Foreground="#38BDF8" FontSize="10" 
                                                FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0"/>
                            </Grid>
                        </Border>
                        
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>