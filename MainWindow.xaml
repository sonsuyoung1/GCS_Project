<Window x:Class="GCS_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" 
        Title="GCS Dashboard" Height="850" Width="1600" Background="#1A1A1A">
    <Window.Resources>
        <Style x:Key="BaseText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="Foreground" Value="#95A5A6"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="GcsButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#4A5568"/>
                                <Setter Property="Foreground" Value="#CBD5E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Leader Drone" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="14" Margin="5,2"/>
                    <vlc:VideoView Grid.Row="1" x:Name="VideoView1" Background="Black"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Follower Drone A" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="14" Margin="5,2"/>
                    <vlc:VideoView Grid.Row="1" x:Name="VideoView2" Background="Black"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Follower Drone B" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="14" Margin="5,2"/>
                    <vlc:VideoView Grid.Row="1" x:Name="VideoView3" Background="Black"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0F172A" Padding="15,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Style="{StaticResource StatusGroup}">
                        <TextBlock Text="MODE " Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding FlightMode}" Foreground="#22C55E"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource StatusGroup}">
                        <TextBlock Text="ARM " Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding IsArmed}" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource StatusGroup}">
                        <TextBlock Text="BAT " Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding BatteryPercentVm, StringFormat={}{0}%}" Foreground="#FACC15"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource StatusGroup}">
                        <TextBlock Text="LINK " Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding IsConnected}" Foreground="#22C55E"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="mapWebView"/>

            </Grid>

            <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#34495E" BorderThickness="0,2,0,0">
                <UniformGrid Columns="5" Margin="10,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LATITUDE" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Latitude, StringFormat={}{0:F5}}" Style="{StaticResource ValueText}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LONGITUDE" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Longitude, StringFormat={}{0:F5}}" Style="{StaticResource ValueText}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ALTITUDE" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Altitude, StringFormat={}{0:F1}m}" Style="{StaticResource ValueText}" Foreground="#2ECC71"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SPEED" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Speed, StringFormat={}{0:F2}}" Style="{StaticResource ValueText}" Foreground="#3498DB"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="STATUS" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="READY" Style="{StaticResource ValueText}" Foreground="#E67E22"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="#1E293B" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="0.8*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="COMMAND CENTER" Foreground="White" FontSize="18" Margin="0,0,0,15"/>

                <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">
                    <Button Content="Mission Start" Command="{Binding StartMissionCommand}" Background="#E74C3C" Style="{StaticResource GcsButton}"/>
                    <Button Content="Stop" Command="{Binding StopMissionCommand}" Background="#E74C3C" Style="{StaticResource GcsButton}"/>
                    <Button Content="Undo" Command="{Binding UndoWaypointCommand}" Background="#4A5568" Style="{StaticResource GcsButton}"/>
                    <Button Content="Clear All" Command="{Binding ClearWaypointsCommand}" Background="#4A5568" Style="{StaticResource GcsButton}"/>
                    <Button Content="ARM" Command="{Binding ArmCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                    <Button Content="DISARM" Command="{Binding DisarmCommand}" Background="#E74C3C" Style="{StaticResource GcsButton}"/>
                    <Button Content="Takeoff" Command="{Binding TakeoffCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                    <Button Content="Landing" Command="{Binding LandingCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                    <Button Content="RTL" Command="{Binding RtlCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                </UniformGrid>

                <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="DETECTED TARGETS" Foreground="#3B82F6" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding MavlinkService.DetectedTargets}" 
                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" 
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="Transparent" Foreground="White" 
                          RowBackground="Transparent" GridLinesVisibility="None" 
                          SelectionMode="Single" BorderThickness="0">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="5,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3B82F6"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="*"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding TargetType}" Width="*"/>
                                <DataGridTextColumn Header="LAT" Binding="{Binding Lat, StringFormat={}{0:F5}}" Width="*"/>
                                <DataGridTextColumn Header="LNG" Binding="{Binding Lng, StringFormat={}{0:F5}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SYSTEM LOG" Foreground="#64748B" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ChatLog}" Foreground="#94A3B8" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <UniformGrid Grid.Row="4" Columns="2">
                    <Button Content="START TRACK" Command="{Binding FollowCommand}" Background="#3B82F6" Style="{StaticResource GcsButton}"/>
                    <Button Content="STOP TRACK" Command="{Binding StopTrackingCommand}" Background="#64748B" Style="{StaticResource GcsButton}"/>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>