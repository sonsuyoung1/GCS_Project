<Window x:Class="GCS_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="GCS Dashboard" Height="850" Width="1600" Background="#1A1A1A">
    <Window.Resources>
        <Style x:Key="BaseText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="Foreground" Value="#95A5A6"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="GcsButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#4A5568"/>
                                <Setter Property="Foreground" Value="#CBD5E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Leader Drone" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="14" Margin="5,2"/>
                    <vlc:VideoView Grid.Row="1" x:Name="VideoView1" Background="Black"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Follower Drone A" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="14" Margin="5,2"/>
                    <vlc:VideoView Grid.Row="1" x:Name="VideoView2" Background="Black"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Follower Drone B" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="14" Margin="5,2"/>
                    <vlc:VideoView Grid.Row="1" x:Name="VideoView3" Background="Black"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0F172A" Padding="15,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Style="{StaticResource StatusGroup}">
                        <TextBlock Text="MODE " Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding FlightMode}" Foreground="#22C55E"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource StatusGroup}">
                        <TextBlock Text="ARM " Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding IsArmed}" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource StatusGroup}">
                        <TextBlock Text="BAT " Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}" Foreground="#FACC15"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource StatusGroup}">
                        <TextBlock Text="LINK " Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding IsConnected}" Foreground="#22C55E"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" x:Name="MapContainer">

                <wv2:WebView2 x:Name="mapWebView" />

                <Popup x:Name="cameraPopup"
       IsOpen="True" AllowsTransparency="True" 
       Placement="Right" PlacementTarget="{Binding ElementName=MapContainer}"
       VerticalOffset="-200" HorizontalOffset="-110">

                    <Border Background="#CC000000" CornerRadius="15" Padding="10" Width="85">
                        <StackPanel>
                            <Border Background="#44FFFFFF" CornerRadius="15" Height="30" Width="65" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M16,16L12,12L16,8V16M11,16H4V8H11V16Z" 
                          Fill="#00FF00" Stretch="Uniform" Width="14" HorizontalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4Z" 
                          Fill="White" Stretch="Uniform" Width="14" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Button x:Name="RecordButton" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,12">
                                <Grid>
                                    <Ellipse Width="50" Height="50" Stroke="White" StrokeThickness="3"/>
                                    <Ellipse Width="36" Height="36" Fill="#FF3B3B"/>
                                </Grid>
                            </Button>

                            <Button x:Name="CaptureButton" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15">
                                <Grid>
                                    <Ellipse Width="50" Height="50" Stroke="White" StrokeThickness="3"/>
                                    <Path Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4Z" 
                          Fill="White" Stretch="Uniform" Width="22"/>
                                </Grid>
                            </Button>

                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.35 19.43,11.03L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.03C4.53,11.35 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                      Fill="#AAAAAA" Stretch="Uniform" Width="20"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup x:Name="myPopup"
           IsOpen="True" 
           AllowsTransparency="True" 
           Placement="Bottom" 
           PlacementTarget="{Binding ElementName=MapContainer}"
           VerticalOffset="-135" 
           HorizontalOffset="630">
                    <StackPanel Orientation="Horizontal" IsHitTestVisible="False">

                        <Border Width="100" Height="100" CornerRadius="50" Margin="20"
        BorderBrush="White" BorderThickness="1.5" Background="#222">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.5" Direction="225"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.Clip>
                                    <EllipseGeometry Center="50,50" RadiusX="49" RadiusY="49"/>
                                </Grid.Clip>

                                <Grid x:Name="HorizonContainer" Height="1000" VerticalAlignment="Center">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform Y="{Binding PitchOffset}"/>
                                            <RotateTransform Angle="{Binding Drone.Roll}" CenterX="50" CenterY="500"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="0" Fill="#4472C4"/>
                                    <Rectangle Grid.Row="1" Fill="#638C3C"/>
                                    <Canvas>
                                        <Rectangle Canvas.Top="499" Width="100" Height="2" Fill="White" Opacity="0.8"/>

                                        <Line X1="35" Y1="464.5" X2="65" Y2="464.5" Stroke="White" StrokeThickness="1.5"/>
                                        <TextBlock Text="10" Foreground="White" FontSize="7" Canvas.Top="460" Canvas.Left="68"/>
                                        <TextBlock Text="10" Foreground="White" FontSize="7" Canvas.Top="460" Canvas.Left="22"/>

                                        <Line X1="40" Y1="429" X2="60" Y2="429" Stroke="White" StrokeThickness="1.2" Opacity="0.8"/>
                                        <TextBlock Text="20" Foreground="White" FontSize="7" Canvas.Top="424" Canvas.Left="63"/>
                                        <TextBlock Text="20" Foreground="White" FontSize="7" Canvas.Top="424" Canvas.Left="28"/>

                                        <Line X1="45" Y1="393.5" X2="55" Y2="393.5" Stroke="White" StrokeThickness="1" Opacity="0.6"/>
                                        <TextBlock Text="30" Foreground="White" FontSize="6" Canvas.Top="389" Canvas.Left="58"/>
                                        <TextBlock Text="30" Foreground="White" FontSize="6" Canvas.Top="389" Canvas.Left="35"/>

                                        <Line X1="35" Y1="535.5" X2="65" Y2="535.5" Stroke="White" StrokeThickness="1.5"/>
                                        <TextBlock Text="-10" Foreground="White" FontSize="7" Canvas.Top="531" Canvas.Left="68"/>
                                        <TextBlock Text="-10" Foreground="White" FontSize="7" Canvas.Top="531" Canvas.Left="15"/>

                                        <Line X1="40" Y1="571" X2="60" Y2="571" Stroke="White" StrokeThickness="1.2" Opacity="0.8"/>
                                        <TextBlock Text="-20" Foreground="White" FontSize="7" Canvas.Top="566" Canvas.Left="63"/>
                                        <TextBlock Text="-20" Foreground="White" FontSize="7" Canvas.Top="566" Canvas.Left="10"/>
                                    </Canvas>
                                </Grid>

                                <Canvas IsHitTestVisible="False">
                                    <Rectangle Canvas.Left="49.2" Canvas.Top="2" Width="1.5" Height="8" Fill="#FF3B3B"/>

                                    <Line X1="50" Y1="2" X2="50" Y2="7" Stroke="White" StrokeThickness="1">
                                        <Line.RenderTransform>
                                            <RotateTransform Angle="-30" CenterX="50" CenterY="50"/>
                                        </Line.RenderTransform>
                                    </Line>
                                    <Line X1="50" Y1="2" X2="50" Y2="7" Stroke="White" StrokeThickness="1">
                                        <Line.RenderTransform>
                                            <RotateTransform Angle="30" CenterX="50" CenterY="50"/>
                                        </Line.RenderTransform>
                                    </Line>
                                    <Line X1="50" Y1="2" X2="50" Y2="10" Stroke="White" StrokeThickness="1.5">
                                        <Line.RenderTransform>
                                            <RotateTransform Angle="-60" CenterX="50" CenterY="50"/>
                                        </Line.RenderTransform>
                                    </Line>
                                    <Line X1="50" Y1="2" X2="50" Y2="10" Stroke="White" StrokeThickness="1.5">
                                        <Line.RenderTransform>
                                            <RotateTransform Angle="60" CenterX="50" CenterY="50"/>
                                        </Line.RenderTransform>
                                    </Line>
                                </Canvas>

                                <Canvas IsHitTestVisible="False">
                                    <Line X1="25" Y1="50" X2="42" Y2="50" Stroke="Yellow" StrokeThickness="2.5"/>
                                    <Line X1="58" Y1="50" X2="75" Y2="50" Stroke="Yellow" StrokeThickness="2.5"/>
                                    <Ellipse Canvas.Left="46.5" Canvas.Top="46.5" Width="7" Height="7" Fill="Yellow"/>
                                </Canvas>
                            </Grid>
                        </Border>

                        <Border Width="100" Height="100" CornerRadius="50" Margin="10"
                    BorderBrush="White" BorderThickness="1.5" Background="#CC000000">
                            <Grid>
                                <Grid>
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="{Binding HeadingOffset}" CenterX="50" CenterY="50"/>
                                    </Grid.RenderTransform>

                                    <Canvas Width="100" Height="100">
                                        <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="30" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="60" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="120" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="150" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="210" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="240" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="300" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Line X1="50" Y1="5" X2="50" Y2="12" Stroke="#AAAAAA" StrokeThickness="1.5">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="330" CenterX="50" CenterY="50"/>
                                            </Line.RenderTransform>
                                        </Line>
                                    </Canvas>

                                    <TextBlock Text="N" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Text="S" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                    <TextBlock Text="E" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <TextBlock Text="W" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Grid>

                                <Viewbox Width="30" Height="30">
                                    <Canvas Width="100" Height="100">
                                        <Path Fill="#EE3424" Data="M 50,0 L 100,100 L 50,75 Z"/>
                                        <Path Fill="#C72B27" Data="M 50,0 L 0,100 L 50,75 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <Path Data="M 0,0 L 8,0 L 4,8 Z" Fill="Yellow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Popup>
            </Grid>

            <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#34495E" BorderThickness="0,2,0,0">
                <UniformGrid Columns="5" Margin="10,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LATITUDE" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Drone.Latitude, StringFormat={}{0:F5}}" Style="{StaticResource ValueText}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LONGITUDE" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Drone.Longitude, StringFormat={}{0:F5}}" Style="{StaticResource ValueText}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ALTITUDE" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Drone.Altitude, StringFormat={}{0:F1}m}" Style="{StaticResource ValueText}" Foreground="#2ECC71"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SPEED" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding Drone.Speed}" Style="{StaticResource ValueText}" Foreground="#3498DB"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="STATUS" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="READY" Style="{StaticResource ValueText}" Foreground="#E67E22"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="#1E293B" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="0.8*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="COMMAND CENTER" Foreground="White" FontSize="18" Margin="0,0,0,15"/>

                <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">
                    <Button Content="Mission Start" Command="{Binding StartMissionCommand}" Background="#E74C3C" Style="{StaticResource GcsButton}"/>
                    <Button Content="Stop" Command="{Binding StopMissionCommand}" Background="#E74C3C" Style="{StaticResource GcsButton}"/>
                    <Button Content="Undo" Command="{Binding UndoWaypointCommand}" Background="#4A5568" Style="{StaticResource GcsButton}"/>
                    <Button Content="Clear All" Command="{Binding ClearWaypointsCommand}" Background="#4A5568" Style="{StaticResource GcsButton}"/>
                    <Button Content="Takeoff" Command="{Binding TakeoffCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                    <Button Content="Landing" Command="{Binding LandingCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                    <Button Content="Return" Command="{Binding RtlCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                    <Button Content="Arm" Command="{Binding ArmCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                    <Button Content="Disarm" Command="{Binding DisarmCommand}" Background="#27AE60" Style="{StaticResource GcsButton}"/>
                </UniformGrid>

                <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="DETECTED TARGETS" Foreground="#3B82F6" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding MavlinkService.DetectedTargets}" 
                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" 
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="Transparent" Foreground="White" 
                          RowBackground="Transparent" GridLinesVisibility="None" 
                          SelectionMode="Single" BorderThickness="0">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="5,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3B82F6"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="*"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding TargetType}" Width="*"/>
                                <DataGridTextColumn Header="LAT" Binding="{Binding Lat, StringFormat={}{0:F5}}" Width="*"/>
                                <DataGridTextColumn Header="LNG" Binding="{Binding Lng, StringFormat={}{0:F5}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SYSTEM LOG" Foreground="#64748B" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ChatLog}" Foreground="#94A3B8" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <UniformGrid Grid.Row="4" Columns="2">
                    <Button Content="START TRACK" Command="{Binding FollowCommand}" Background="#3B82F6" Style="{StaticResource GcsButton}"/>
                    <Button Content="STOP TRACK" Command="{Binding StopTrackingCommand}" Background="#64748B" Style="{StaticResource GcsButton}"/>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>